# Postgres. En Vercel: conexión con pooler (Neon la crea sola al conectar la integración)
DATABASE_URL="postgresql://daely:daely_pass@localhost:5434/daely?schema=public"
# Conexión directa para migraciones (opcional en local; Neon la crea como DATABASE_URL_UNPOOLED)
# DATABASE_URL_UNPOOLED=""

# Secreto largo y aleatorio. Genéralo con: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# URL pública del sitio. En Vercel puedes omitirla: se usa el dominio de producción automáticamente
BETTER_AUTH_URL="http://localhost:3000"

# Admin del dashboard (se crea/actualiza en cada deploy)
ADMIN_EMAIL="admin@daely.com"
ADMIN_PASSWORD=""
